{
  "name": "flyer",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": "20.18.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "check:lock": "node scripts/check-lock.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:rules:full": "node scripts/check-rules.mjs --expressions",
    "test:rules": "npm --prefix tests/rules test",
    "fixdeps": "npx expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^21.13.0",
    "@react-native-firebase/auth": "^21.13.0",
    "@react-native-firebase/database": "^21.13.0",
    "@react-native-firebase/functions": "^21.13.0",
    "@react-native-firebase/messaging": "^21.13.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "expo": "~53.0.0",
    "expo-application": "~6.1.4",
    "expo-asset": "~11.1.7",
    "expo-av": "~15.1.4",
    "expo-build-properties": "~0.14.6",
    "expo-clipboard": "~7.1.4",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.9",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-manipulator": "~13.1.5",
    "expo-image-picker": "~16.1.4",
    "expo-keep-awake": "~14.1.4",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.8",
    "expo-video-thumbnails": "~9.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-callkeep": "^4.3.16",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-incall-manager": "^4.2.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "react-native-webrtc": "^124.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^12.0.0",
    "@types/react": "~19.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-callkeep",
          "react-native-incall-manager",
          "react-native-webrtc",
          "expo-av"
        ],
        "listUnknownPackages": false
      }
    }
  }
}

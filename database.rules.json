{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      // No `.read` at this level, deliberately.
      //
      // Enumeration in RTDB is a read of the *parent*: listing children or
      // running `orderByChild('email').equalTo(...)` requires permission here,
      // not on the rows. This node used to grant `auth != null`, so any account —
      // one made seconds ago — could download every user, email, about text and
      // last-seen in a single request. Granting read per-row below means a client
      // can only resolve a uid it already has (a chat participant, a group
      // member, a contact request), and no query returns a row the caller could
      // not already name.
      //
      // `.indexOn` stays: an index is not a permission. It makes the email
      // lookup in the `searchUsers` callable a seek rather than a full scan, and
      // grants nothing to a client that cannot read this node to begin with.
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email', 'createdAt'])",
        "uid": {
          // Denormalised copy of the key. Redundant, but the client writes it and the profile object is passed around as a self-contained value, so it has to be permitted — and pinned to the key so it can never disagree with it.
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "username": {
          // Lowercase handle. Uniqueness is enforced by the `usernames` index, not here — this field only has to match the claim. The check walks up via newData rather than `root` because `root` is the pre-write state, and the claim is written in the same fan-out as this field.
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.]{3,24}$/) && newData.parent().parent().parent().child('usernames').child(newData.val()).val() === $uid"
        },
        "email": {
          // An allowlist rather than the `[^@\s]` denylist this used to be, because the rules regex engine has no `\s`: it rejected the whole file at parse time, which is why nothing here could be deployed. Denylisting whitespace is not merely awkward but impossible — `\t` inside a class is read as a literal `t`, `[:space:]` as the literal letters a,c,e,p,s, and a real newline ends the regex literal, so there is no way to spell "not whitespace". The class is RFC 5322 atext, deliberately wider than any address seen in practice: this field is populated from Firebase Auth, and a rule stricter than Auth would turn a legal address into a signup that cannot complete. Empty is allowed because AuthManager writes `user.email ?? ''` — an account with no address gets an empty profile field rather than a PERMISSION_DENIED it cannot recover from.
          ".validate": "newData.isString() && newData.val().length <= 254 && (newData.val() === '' || newData.val().matches(/^[A-Za-z0-9!#$%&'*+=?^_`{|}~.\\/-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/))"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048 || newData.val() === null"
        },
        "about": {
          ".validate": "newData.isString() && newData.val().length <= 256"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },
        "privacy": {
          ".validate": "newData.hasChildren(['showLastSeen', 'showPhoto', 'showAbout', 'readReceipts'])",
          "showLastSeen": { ".validate": "newData.isBoolean()" },
          "showPhoto": { ".validate": "newData.isBoolean()" },
          "showAbout": { ".validate": "newData.isBoolean()" },
          "readReceipts": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "usernames": {
      // handle -> uid. A claim may only be created if free, and only deleted by its owner — that pair is what makes handles unique without a server.
      //
      // Read is granted per handle, not on this parent. With parent read, an
      // `orderByKey()` range enumerates every handle in the app and maps each to
      // a uid, and the per-uid profile reads below then reassemble the very user
      // table the `users` rule above stopped handing out. Resolving a handle
      // somebody gave you still works; discovering handles nobody gave you is
      // the `searchUsers` callable in functions/index.js.
      "$handle": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $handle.matches(/^[a-z0-9_.]{3,24}$/)"
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$token": {
          ".validate": "newData.hasChildren(['platform', 'updatedAt']) && $token.length <= 4096",
          "platform": {
            ".validate": "newData.isString() && newData.val().matches(/^(ios|android)$/)"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",

        // Create only. 1:1 ids are the sorted uid join, so membership is provable from the key itself; group ids are push keys, so the proof is that the creator writes themselves in as participant and admin.
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('participants').child(auth.uid).val() === true && !newData.hasChild('mutedBy') && !newData.hasChild('clearedAt') && (($chatId.contains(auth.uid) && newData.child('isGroup').val() !== true) || (newData.child('isGroup').val() === true && newData.child('admins').child(auth.uid).val() === true && newData.child('createdBy').val() === auth.uid))",

        "isGroup": { ".validate": "newData.isBoolean()" },
        "createdBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },

        "name": {
          ".write": "auth != null && root.child('chats').child($chatId).child('isGroup').val() === true && root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "photoURL": {
          ".write": "auth != null && root.child('chats').child($chatId).child('isGroup').val() === true && root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 2048)"
        },
        "description": {
          ".write": "auth != null && root.child('chats').child($chatId).child('isGroup').val() === true && root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 300)"
        },

        "admins": {
          "$uid": {
            // Admins grant and revoke. The self-clause is what lets a departing admin drop their own badge in the same fan-out that removes them.
            ".write": "auth != null && root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (auth != null && auth.uid === $uid && !newData.exists())",
            ".validate": "newData.val() === true && newData.parent().parent().child('participants').child($uid).val() === true"
          }
        },

        "participants": {
          "$uid": {
            // Three ways this changes: a 1:1 chat proves membership from the key, a group admin adds or removes, or a member removes themselves by leaving.
            ".write": "auth != null && (($chatId.contains(auth.uid) && $chatId.contains($uid) && !data.exists() && newData.val() === true) || root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !newData.exists()))",
            ".validate": "newData.val() === true && ($chatId.contains($uid) || newData.parent().parent().child('isGroup').val() === true)"
          }
        },

        "lastMessage": {
          ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['text', 'type', 'senderId'])",
          "text": { ".validate": "newData.isString() && newData.val().length <= 4096" },
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(text|image|video|audio|system)$/)" },
          "senderId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "lastTimestamp": {
          ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },

        "unread": {
          "$uid": {
            // Membership is read from the *merged* tree, not `root`: a new member's counter is seeded to 0 in the same fan-out that adds them, so the pre-write state does not know them yet. Deletes are the mirror case — the participant disappears alongside the counter, so authority for those comes from `root`.
            ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists() && (newData.parent().parent().child('participants').child($uid).exists() || (!newData.exists() && (root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true || auth.uid === $uid)))",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },

        "mutedBy": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && (newData.val() >= 0 || newData.val() === -1)"
          }
        },

        "clearedAt": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },

        "$other": { ".validate": false }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastTimestamp"],
        "$chatId": {
          // Owner writes their own index freely. Others may only bump it, and only if they share the chat: a 1:1 peer is provable from the key, a group member from the participant list. The last clause is for group admins, who seed a new member's index when adding them and clear it when removing them — in neither case is the target a participant in the pre-write tree, so the clause above cannot cover it.
          ".write": "auth != null && ((auth.uid === $uid && ($chatId.contains($uid) || root.child('chats').child($chatId).child('participants').child($uid).exists())) || ($chatId.contains($uid) && $chatId.contains(auth.uid)) || (root.child('chats').child($chatId).child('participants').child(auth.uid).exists() && root.child('chats').child($chatId).child('participants').child($uid).exists()) || root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChild('lastTimestamp')",
          "lastTimestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "pinned": { ".validate": "newData.isBoolean()" },
          "archived": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
        ".indexOn": ["timestamp"],

        "$messageId": {
          // Create only, by a participant, attributed to themselves — and not
          // into a 1:1 chat where either side has blocked the other. That last
          // clause is what makes blocking real: it was enforced nowhere before,
          // so a blocked user's messages were written and delivered normally.
          // `blockPairs` is consulted rather than `blocks` because a rule may
          // only read what the writer could read (see that node's comment).
          ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists() && !data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid && !root.child('blockPairs').child($chatId).hasChildren()",
          ".validate": "newData.hasChildren(['senderId', 'type', 'timestamp'])",

          "senderId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(text|image|video|audio|system)$/)"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },

          "text": {
            ".write": "auth != null && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 4096"
          },
          "edited": {
            ".write": "auth != null && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "deleted": {
            ".write": "auth != null && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "mediaUrl": {
            ".write": "auth != null && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "thumbUrl": {
            ".write": "auth != null && data.parent().child('senderId').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "width": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "height": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "forwardedFrom": { ".validate": "newData.isString() && newData.val().length <= 128" },

          "event": {
            // Only on system rows, and only in a group. `by` must be the author: the transcript's account of who did something has to match who wrote it.
            ".validate": "newData.parent().child('type').val() === 'system' && root.child('chats').child($chatId).child('isGroup').val() === true && newData.hasChild('kind') && (!newData.hasChild('by') || newData.child('by').val() === auth.uid)",
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(group_created|members_added|member_removed|member_left|group_renamed|group_photo_changed|admin_granted|admin_revoked)$/)"
            },
            "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "uids": {
              "$index": { ".validate": "newData.isString() && newData.val().length <= 128" }
            },
            "$other": { ".validate": false }
          },

          "replyTo": {
            ".validate": "newData.hasChildren(['messageId', 'senderId', 'type', 'preview'])",
            "messageId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "senderId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(text|image|video|audio)$/)" },
            "preview": { ".validate": "newData.isString() && newData.val().length <= 256" },
            "$other": { ".validate": false }
          },

          "seenBy": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() > 0 && $uid === auth.uid"
            }
          },

          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16 && $uid === auth.uid"
            }
          },

          "hiddenFor": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
              ".validate": "newData.isBoolean() && $uid === auth.uid"
            }
          },

          "$other": { ".validate": false }
        }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() > 0"
        }
      }
    },

    "starred": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$key": {
          ".validate": "newData.hasChildren(['chatId', 'messageId', 'starredAt']) && $key.contains('__')",
          "chatId": { ".validate": "newData.isString() && newData.val().length <= 256 && $key.beginsWith(newData.val())" },
          "messageId": { ".validate": "newData.isString() && newData.val().length <= 128 && $key.endsWith(newData.val())" },
          "starredAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },

    "blocks": {
      // The blocker's private list. Drives their own UI ("Unblock") and is the
      // node Cloud Functions consults before sending a push. Deliberately not
      // readable by the person blocked — see `blockPairs` for the half that has
      // to be mutually visible.
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".validate": "newData.val() === true && $otherUid !== auth.uid"
        }
      }
    },

    "blockPairs": {
      // Enforcement mirror for 1:1 blocking, keyed by the pair's chat id.
      //
      // A rule cannot consult `blocks/{peer}/{me}` to reject a send, because the
      // rule would be asking a question the sender is not allowed to ask, and
      // making `blocks` readable to the blocked party would tell them they had
      // been blocked — precisely what blocking withholds. Keying by chatId
      // instead means both parties can read the node (the key names them both)
      // while neither learns which *direction* the block runs in without also
      // checking their own list, which only they can see.
      //
      // Group chats never appear here: their ids are push keys, and blocking
      // someone does not eject them from a group you share.
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $chatId.contains(auth.uid) && $chatId.contains($uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "reports": {
      ".read": false,
      ".write": false,
      "$reportId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['reporterId', 'reportedId', 'reason', 'createdAt'])",
        "reporterId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "reportedId": { ".validate": "newData.isString() && newData.val().length <= 128 && newData.val() !== auth.uid" },
        "reason": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1024" },
        "chatId": { ".validate": "newData.isString() && newData.val().length <= 256" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "calls": {
      ".indexOn": ["state"],
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('callerId').val() === auth.uid && newData.child('calleeId').val() !== auth.uid && !newData.hasChild('answer') && !newData.hasChild('candidates')",
        ".validate": "newData.hasChildren(['callerId', 'calleeId', 'type', 'state', 'createdAt'])",

        "callerId": {
          ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())"
        },
        "calleeId": {
          ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(voice|video)$/) && (!data.exists() || data.val() === newData.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },

        "state": {
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().matches(/^(idle|calling|ringing|accepted|rejected|ended)$/)"
        },
        "answeredAt": {
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "endedAt": {
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "endedReason": {
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().matches(/^(hangup|rejected|missed|failed|busy)$/)"
        },

        "offer": {
          ".write": "auth != null && data.parent().child('callerId').val() === auth.uid",
          ".validate": "newData.hasChildren(['type', 'sdp'])",
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(offer|pranswer)$/)" },
          "sdp": { ".validate": "newData.isString() && newData.val().length <= 32768" },
          "$other": { ".validate": false }
        },
        "answer": {
          ".write": "auth != null && data.parent().child('calleeId').val() === auth.uid",
          ".validate": "newData.hasChildren(['type', 'sdp'])",
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(answer|pranswer)$/)" },
          "sdp": { ".validate": "newData.isString() && newData.val().length <= 32768" },
          "$other": { ".validate": false }
        },

        "candidates": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            "$candidateId": {
              ".validate": "newData.hasChild('candidate')",
              "candidate": { ".validate": "newData.isString() && newData.val().length <= 2048" },
              "sdpMid": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "sdpMLineIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "usernameFragment": { ".validate": "newData.isString() && newData.val().length <= 256" },
              "$other": { ".validate": false }
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "incoming": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.exists() && newData.child('callerId').val() === auth.uid && newData.child('callId').val() === $callId))",
          ".validate": "newData.hasChildren(['callId', 'callerId', 'type', 'createdAt'])",
          "callId": { ".validate": "newData.isString() && newData.val() === $callId" },
          "callerId": { ".validate": "newData.isString() && newData.val().length <= 128 && newData.val() !== $uid" },
          "callerName": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "callerPhoto": { ".validate": "newData.isString() && newData.val().length <= 2048" },
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(voice|video)$/)" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },

    "callHistory": {
      "$uid": {
        // Cloud Functions is the only author — it writes both sides of a call when the call ends, using the admin SDK, which bypasses these rules. The client may read its own history and delete from it (clearing the list, or swiping one entry away), but may never create or alter a row: an entry the client could forge is a call log that cannot be trusted.
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        ".indexOn": ["startedAt"],
        "$callId": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },

    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["addedAt"],
        "$contactUid": {
          // Two legitimate writers. (a) The owner: may always remove, but may only add when a request from that person is pending — so nobody can silently insert themselves into your list. (b) The person being added, writing the reciprocal entry into the requester's list while accepting. `root` is the pre-write state, so the still-unaccepted request is visible to both halves of the atomic accept.
          ".write": "auth != null && $contactUid !== $uid && ((auth.uid === $uid && (!newData.exists() || root.child('contactRequests').child($uid).child($contactUid).exists())) || (auth.uid === $contactUid && newData.exists() && root.child('contactRequests').child($contactUid).child($uid).exists()))",
          ".validate": "newData.hasChildren(['uid', 'addedAt'])",
          "uid": { ".validate": "newData.isString() && newData.val() === $contactUid" },
          "addedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },

    "contactRequests": {
      "$uid": {
        // The recipient's inbox. Only they can read it; the sender tracks their own pending requests in `sentRequests` instead.
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["createdAt"],
        "$fromUid": {
          // The sender may create one (unless blocked, already a contact, or one already exists) and may cancel it. The recipient may only delete — accepting and declining are both deletions, and which one it was is decided by whether contacts entries are written in the same fan-out.
          ".write": "auth != null && $fromUid !== $uid && ((auth.uid === $fromUid && (!newData.exists() || (!data.exists() && !root.child('blocks').child($uid).child($fromUid).exists() && !root.child('blocks').child($fromUid).child($uid).exists() && !root.child('contacts').child($uid).child($fromUid).exists()))) || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['uid', 'createdAt'])",
          "uid": { ".validate": "newData.isString() && newData.val() === $fromUid" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },

    "sentRequests": {
      "$uid": {
        // The sender's outbox, mirroring `contactRequests`. The recipient needs delete rights here so that accepting or declining clears the sender's pending state in the same atomic write.
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["createdAt"],
        "$toUid": {
          ".write": "auth != null && $toUid !== $uid && (auth.uid === $uid || (auth.uid === $toUid && !newData.exists()))",
          ".validate": "newData.hasChildren(['uid', 'createdAt'])",
          "uid": { ".validate": "newData.isString() && newData.val() === $toUid" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
